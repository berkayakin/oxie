// A lookup returned before an insert into the same map: the entry API looks the key up once.

import std::collections::HashMap

fun load(id: u32): String = "user $id"

fun name_of(cache: &mut HashMap<u32, String>, id: u32): &String {
    if (val name = cache.get(&id)) return name
    cache.insert(id, load(id))
    return cache.get(&id)!!
}
// error: 9: `cache.entry(id).or_insert_with { load(id) }`
// error: 9: fix: look `id` up once with `cache.entry()`

class Users(var names: HashMap<String, String> = HashMap::new()) {
    fun name_of(key: &str): &String {
        if (val name = names.get(key)) return name
        // a field, and a comment the fix would remove: only the explanation
        names.insert(key.to_string(), key.to_uppercase())
        return names.get(key)!!
    }
}
// error: 19: `names.entry(key.to_string()).or_insert_with { key.to_uppercase() }`
// not: 19: fix:

// another key than the one looked up
fun next_of(cache: &mut HashMap<u32, String>, id: u32): &String {
    if (val name = cache.get(&id)) return name
    cache.insert(id + 1, load(id))
    return cache.get(&id)!!
}
// error: 29: can't be changed while it is borrowed
// not: 29: or_insert_with

fun main() {
    var cache: HashMap<u32, String> = HashMap::new()
    println(name_of(cache, 1))
    println(next_of(cache, 1))
    var users = Users()
    println(users.name_of("ada"))
}
