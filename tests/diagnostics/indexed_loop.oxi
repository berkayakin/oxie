// Changing `v[i]` in a loop over `v.iter().enumerate()`: the loop can go over `v.iter_mut()`.

fun double(n: &i32): i32 = n * 2

fun main() {
    var v = vec[1, 2, 3]
    for ((i, x) in v.iter().enumerate()) { v[i] = x * 2 }
    // error: 7: `for (x in v.iter_mut()) { *x = *x * 2 }`
    // error: 7: fix: change the elements through `v.iter_mut()`
    var w = vec[1.5, 2.5]
    for ((i, x) in w.iter().enumerate()) {
        w[i] = -x + i as f64
    }
    // error: 12: `for ((i, x) in w.iter_mut().enumerate()) { *x = -*x + i as f64 }`
    // error: 12: fix: change the elements through `w.iter_mut()`
    for ((i, x) in v.iter().enumerate()) { v[i] = double(x) }
    // error: 16: `for (x in v.iter_mut()) { *x = ... }`
    // not: 16: fix: change the elements
    for ((i, x) in v.iter().enumerate()) { if (i > 0) v[i] = v[i - 1] + x }
    // error: 19: can't be changed while it is borrowed
    // not: 19: iter_mut
    println("${v:?} ${w:?}")
}
