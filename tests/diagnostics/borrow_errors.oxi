fun register(names: &mut Vec<String>, name: String) = names.push(name)

fun main() {
    var names: Vec<String> = vec[]
    val name = "Ada".to_string()
    register(names, name)
    println("${names.len()} $name")
    // error: 7: borrow of moved value
    val x = 5
    x = 6
    // error: 10: cannot assign twice
}
