fun register(names: &mut Vec<String>, name: String) = names.push(name)

fun main() {
    var names: Vec<String> = vec[]
    val name = "Ada".to_string()
    register(names, name)
    println("${names.len()} $name")
    // error: 7: borrow of moved value
    val x = 5
    x = 6
    // error: 10: cannot assign twice
}

// the text of a `toString` is a `String`: a field it gives isn't lent with `&` (a `val` is)
class Person(val name: String, val items: Vec<String>) {
    override fun toString(): String {
        val first = items[0]
        // error: 17: fix: pass a reference (`&`): `val first = &items[0]`
        if (first.is_empty()) return name
        // error: 19: can't take `self.name` out of a value that is only borrowed
        // not: 19: pass a reference
        // not: 19: consider borrowing
        name
        // error: 23: can't take `self.name` out of a value that is only borrowed
        // not: 23: pass a reference
        // not: 23: consider borrowing
    }
}

class Nick(val name: String, val nick: String, val short: bool) {
    override fun toString() = if (short) nick else name
    // error: 31: can't take `self.nick` out of a value that is only borrowed
    // error: 31: can't take `self.name` out of a value that is only borrowed
    // not: 31: pass a reference
}
