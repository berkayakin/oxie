class Cart(var items: Vec<String>, var log: Vec<String> = vec[]) {
    // changes `items` too, the list `check` goes over: the conflict is real
    fun record(s: &str) {
        log.push(s.to_string())
        items.push(s.to_string())
    }
    fun check() {
        for (item in items) record(item)
        // error: 8: loop over a copy of `items`
    }
}

fun main() {
    var c = Cart(vec["a".to_string()])
    c.check()
}
