[
  {
    "label": "brs run",
    "command": "brs",
    "args": ["run", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "tags": ["brs-main"]
  },
  {
    "label": "brs run --release",
    "command": "brs",
    "args": ["run", "--release", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "tags": ["brs-main"]
  },
  {
    "label": "brs test: $ZED_CUSTOM_BRS_TEST_NAME",
    "command": "brs",
    "args": ["test", "$ZED_FILE", "$ZED_CUSTOM_BRS_TEST_NAME"],
    "cwd": "$ZED_DIRNAME",
    "tags": ["brs-test"]
  },
  {
    "label": "brs test (all)",
    "command": "brs",
    "args": ["test", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "tags": ["brs-test", "brs-main"]
  },
  {
    "label": "brs emit (show generated Rust)",
    "command": "brs",
    "args": ["emit", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "tags": ["brs-main"]
  }
]
